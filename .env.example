# Everything below is optional: the Entra connection (tenant, client id, client secret) is entered in Settings and kept in the database.
# BROOM_KEY encrypts the client secret stored there (recommended; do not change it afterwards).
BROOM_KEY=
# Development fallback for the Entra connection; what is saved in Settings wins.
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=
# Session signing key. Empty = generated once and kept in the database.
SECRET_KEY=
DATABASE_PATH=instance/broom365.sqlite
# Production: SQL Server instead of the SQLite file.
# DATABASE_URL=mssql+pyodbc://user:password@host:1433/broom365?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# app (default): uses the Application permissions already granted to the app registration. No Microsoft sign-in.
# delegated: interactive Microsoft sign-in with Delegated permissions (also needs REDIRECT_URI).
AUTH_MODE=app
# REDIRECT_URI=http://localhost:5000/auth/callback
