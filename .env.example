# Optional: Broom365 needs no environment file. The installer asks for the database and the key, and the Microsoft 365 connection is
# entered on the Connect page (later in Settings). Use this file only for what the app cannot ask:

DATABASE_PATH=instance/broom365.sqlite

# app (default): uses the Application permissions already granted to the app registration. No Microsoft sign-in.
# delegated: interactive Microsoft sign-in with Delegated permissions (also needs REDIRECT_URI).
AUTH_MODE=app
# REDIRECT_URI=http://localhost:5000/auth/callback

# Automated deployments can set these instead of using the installer; they win over what the installer saved.
# DATABASE_URL=mssql+pyodbc://user:password@host:1433/broom365?driver=ODBC+Driver+18+for+SQL+Server
# BROOM_KEY=a long random string
