# Copy to .env next to docker-compose.yml (Compose reads it). Never commit the real file.
# Nothing here is required: open the page and the installer asks for the database and the key. These override what it saved.
# External SQL Server (optional).
DATABASE_URL=
# DATABASE_URL=mssql+pyodbc://user:password@host:1433/broom365?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
# Encrypts the Entra client secret stored in the database. Keep it; changing it means entering the secret again.
BROOM_KEY=
# Use your own registry instead of Docker Hub (optional):
# BASE_IMAGE=python:3.11-slim-bookworm
# Only for `docker compose --profile mssql` (a throw-away SQL Server for development):
# MSSQL_IMAGE=mcr.microsoft.com/mssql/server:2022-latest
# MSSQL_SA_PASSWORD=ChangeMe-Str0ng!Passw0rd
